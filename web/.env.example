# Read ONLY by src/lib/config.ts. Both are optional.

# Base URL of the operator/verifier API. Default: /api (same origin).
VITE_API_URL=/api

# "testnet" (default) or "mainnet". Any other value is a startup error.
VITE_ZEC_NETWORK=testnet

# Block explorer links for transaction ids. Each must be an https URL that
# contains {txid} exactly once. Defaults shown.
VITE_EXPLORER_TESTNET_TX_URL=https://testnet.zecblock.com/tx/{txid}
VITE_EXPLORER_MAINNET_TX_URL=https://mainnet.zcashexplorer.app/transactions/{txid}

# Block explorer pages for a transparent address (the campaign's funding
# address on a receipt). Each must be an https URL that contains {address}
# exactly once. Defaults shown.
VITE_EXPLORER_TESTNET_ADDRESS_URL=https://testnet.zecblock.com/address/{address}
VITE_EXPLORER_MAINNET_ADDRESS_URL=https://mainnet.zcashexplorer.app/address/{address}

# Where the PUBLIC receipt page is hosted (an https origin, or http://localhost
# for development). Used to build the "Share receipt" link and the origin of a
# payslip link. Optional: without it a receipt link is shown as a path and a
# payslip link uses the origin of the page that makes it.
# VITE_PUBLIC_RECEIPT_BASE_URL=https://verify.example.org

# "true" for a build hosted publicly as the receipt viewer only: the operator
# pages (campaigns, new campaign, audit) then explain that they need the operator
# on your own machine, instead of calling one. A page served from any name other
# than localhost / 127.0.0.1 / [::1] behaves this way even without it.
# VITE_PUBLIC_ONLY=true
