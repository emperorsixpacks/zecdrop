# Copy to .env (never commit it) and fill in both lines.
# The name you pointed at this VPS, without https://
VERIFIER_DOMAIN=verifier.example.com
# The exact origin of the web site: no path, no trailing slash
CORS_ORIGIN=https://zecdrop-site.vercel.app
# Optional: also serve mainnet receipts. Leave it out for testnet only. Check from this host first:
#   curl -sS -o /dev/null -w "%{http_code}\n" https://zec.rocks:443   (any answer means the host is reachable)
# MAINNET_ENDPOINT=https://zec.rocks:443
